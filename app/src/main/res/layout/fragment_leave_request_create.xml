<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:background="#FFFFFF">

            <ImageButton
                android:id="@+id/btnLmRequestCreateBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/tvLmRequestCreateTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="New Leave Request"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Leave Type -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leave Type"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#334155" />

                <LinearLayout
                    android:id="@+id/layoutLmRequestLeaveType"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_pc_input"
                    android:paddingHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvLmRequestLeaveTypeSelected"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Select Leave Type"
                        android:textSize="14sp"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="\u25BC"
                        android:textSize="11sp"
                        android:textColor="#94A3B8" />
                </LinearLayout>

                <!-- Leave Date — shown once a Leave Type is picked (both types need it) -->
                <LinearLayout
                    android:id="@+id/groupLmRequestLeaveDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Leave Date"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#334155"
                        android:layout_marginTop="16dp" />

                    <LinearLayout
                        android:id="@+id/layoutLmRequestLeaveDate"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_pc_input"
                        android:paddingHorizontal="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvLmRequestLeaveDateSelected"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Select Leave Date"
                            android:textSize="14sp"
                            android:textColor="#94A3B8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="\uD83D\uDCC5"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Duty Date — shown only when leaveType == Exchange -->
                <LinearLayout
                    android:id="@+id/groupLmRequestDutyDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Duty Date"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#334155"
                        android:layout_marginTop="16dp" />

                    <LinearLayout
                        android:id="@+id/layoutLmRequestDutyDate"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_pc_input"
                        android:paddingHorizontal="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvLmRequestDutyDateSelected"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Select Duty Date"
                            android:textSize="14sp"
                            android:textColor="#94A3B8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="\uD83D\uDCC5"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Leave Reliever — same branch, same role, active, excluding self -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leave Reliever (Optional)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:layout_marginTop="16dp" />

                <LinearLayout
                    android:id="@+id/layoutLmRequestReliever"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_pc_input"
                    android:paddingHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvLmRequestRelieverSelected"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Select Reliever"
                        android:textSize="14sp"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="\u25BC"
                        android:textSize="11sp"
                        android:textColor="#94A3B8" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLmRequestRelieverHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:textSize="11sp"
                    android:textColor="#94A3B8" />

                <!-- Reason / Remarks -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reason / Remarks"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:layout_marginTop="16dp" />

                <EditText
                    android:id="@+id/etLmRequestReason"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_pc_input"
                    android:hint="Describe the reason for this leave"
                    android:textSize="14sp"
                    android:textColor="#0F172A"
                    android:padding="14dp"
                    android:gravity="top"
                    android:maxLength="200"
                    android:inputType="textMultiLine" />

                <TextView
                    android:id="@+id/tvLmRequestReasonCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:text="0/200"
                    android:textSize="11sp"
                    android:textColor="#94A3B8" />

                <!-- Submit -->
                <Button
                    android:id="@+id/btnLmRequestSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Submit Request"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#059669"
                    android:paddingVertical="12dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
