<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@color/theme_bg_card"
    android:layout_marginBottom="8dp">

    <CheckBox
        android:id="@+id/cbScanQueueSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/tvScanQueueCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CODE"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/theme_text_primary" />

        <TextView
            android:id="@+id/tvScanQueueMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="agent • time"
            android:textSize="12sp"
            android:textColor="@color/theme_text_secondary"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvScanQueueState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ Approved"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnScanQueueApprove"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="✓"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnScanQueueReject"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="✕"
        android:textSize="14sp"
        android:layout_marginStart="6dp" />
</LinearLayout>
