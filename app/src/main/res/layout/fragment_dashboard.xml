<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_bg_dashboard">

    <!-- Pull-to-refresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- ── Date Header ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <!-- Date label -->
                    <TextView
                        android:id="@+id/tvDateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today"
                        android:textSize="18sp"
                        android:textColor="@color/theme_text_primary"
                        android:textStyle="bold"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvDateSubLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/theme_text_secondary" />

                    <!-- Date range chips -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipToday"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Today"
                                android:textSize="11sp"
                                android:layout_marginEnd="6dp"
                                android:checked="true"
                                app:chipBackgroundColor="@color/chip_selector"
                                app:checkedIconVisible="false" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipYesterday"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Yesterday"
                                android:textSize="11sp"
                                android:layout_marginEnd="6dp"
                                app:chipBackgroundColor="@color/chip_selector"
                                app:checkedIconVisible="false" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipLast7"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Last 7 Days"
                                android:textSize="11sp"
                                android:layout_marginEnd="6dp"
                                app:chipBackgroundColor="@color/chip_selector"
                                app:checkedIconVisible="false" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipThisMonth"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="This Month"
                                android:textSize="11sp"
                                android:layout_marginEnd="6dp"
                                app:chipBackgroundColor="@color/chip_selector"
                                app:checkedIconVisible="false" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipCustom"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Custom"
                                android:textSize="11sp"
                                app:chipBackgroundColor="@color/chip_selector"
                                app:checkedIconVisible="false" />

                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Branch filter (only shown when the user has access to more than
                         one branch — see DashboardFragment.observeState()) -->
                    <TextView
                        android:id="@+id/tvBranchDropdown"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginTop="8dp"
                        android:text="All Branches ▾"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:background="@drawable/bg_filter_chip_inactive"
                        android:textColor="@color/theme_text_secondary"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- ── Section: Overview ── -->
                <TextView
                    android:id="@+id/tvSectionOverview"
                    style="@style/DashboardSectionLabel"
                    android:text="Parcel Overview" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="0dp">

                    <include android:id="@+id/cardTotal"     layout="@layout/item_metric_card" />
                    <include android:id="@+id/cardDelivered" layout="@layout/item_metric_card" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <include android:id="@+id/cardOnHold"   layout="@layout/item_metric_card" />
                    <include android:id="@+id/cardReturned" layout="@layout/item_metric_card" />

                </LinearLayout>

                <!-- ── Section: Runs ── -->
                <TextView
                    android:id="@+id/tvSectionRuns"
                    style="@style/DashboardSectionLabel"
                    android:text="Run Status" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <include android:id="@+id/cardTotalRuns"  layout="@layout/item_metric_card" />
                    <include android:id="@+id/cardOpenRuns"   layout="@layout/item_metric_card" />
                    <include android:id="@+id/cardClosedRuns" layout="@layout/item_metric_card" />

                </LinearLayout>

                <!-- ── Section: Earnings ── -->
                <TextView
                    android:id="@+id/tvSectionEarnings"
                    style="@style/DashboardSectionLabel"
                    android:text="Earnings" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <include android:id="@+id/cardEarnings" layout="@layout/item_metric_card" />

                </LinearLayout>

                <!-- ── Section: Distribution ── -->
                <TextView
                    android:id="@+id/tvSectionDist"
                    style="@style/DashboardSectionLabel"
                    android:text="Status Distribution" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/theme_bg_card"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- Segmented bar -->
                        <LinearLayout
                            android:id="@+id/layoutStatusBar"
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:orientation="horizontal"
                            android:clipToOutline="true"
                            android:layout_marginBottom="14dp" />

                        <!-- Legend list (dynamic — one row per distinct status found in range) -->
                        <LinearLayout
                            android:id="@+id/layoutStatusLegend"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- ── Section: Agent Leaderboard (admin/branch only) ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvSectionAgents"
                        style="@style/DashboardSectionLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Agent Performance"
                        android:visibility="gone" />

                    <!-- Manager-only toggle: supervisor rollup (default) vs flat worker
                         list. DashboardFragment shows/hides this based on
                         Success.role == "manager" and keeps its text in sync with the
                         ViewModel's rollupMode. -->
                    <TextView
                        android:id="@+id/tvRollupToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/theme_accent"
                        android:text="👥 By Supervisor ▾"
                        android:visibility="gone"
                        android:padding="4dp" />

                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAgents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/theme_bg_card"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Header row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:background="@color/theme_bg_dashboard_inner">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="AGENT"
                                android:textSize="9sp"
                                android:textColor="@color/theme_text_secondary"
                                android:textAllCaps="true"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓  ↩  ⏸  RATE"
                                android:textSize="9sp"
                                android:textColor="@color/theme_text_secondary"
                                android:textAllCaps="true"
                                android:letterSpacing="0.08" />

                        </LinearLayout>

                        <!-- Dynamic agent rows go here -->
                        <LinearLayout
                            android:id="@+id/layoutAgentRows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:divider="@drawable/divider_dark"
                            android:showDividers="middle" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Loading overlay -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminateTint="@color/theme_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading dashboard…"
            android:textColor="@color/theme_text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="10dp" />

    </LinearLayout>

    <!-- Error view -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Something went wrong"
            android:textColor="@color/theme_red"
            android:textSize="13sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnRetry"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Retry"
            android:layout_marginTop="16dp"
            android:textColor="@color/theme_accent"
            app:strokeColor="@color/theme_accent" />

    </LinearLayout>

</FrameLayout>
