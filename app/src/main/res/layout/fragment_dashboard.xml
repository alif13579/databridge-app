<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeVdRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ভেরিফাই ও ডেলিভারি রিকোয়েস্ট"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/theme_text_primary" />

        <ProgressBar
            android:id="@+id/pbVdLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvVdError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#DC2626"
            android:textSize="12.5sp"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <!-- Filters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvVdDateRange"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_rounded"
                android:padding="10dp"
                android:textSize="12.5sp"
                android:textColor="@color/theme_text_primary"
                android:drawablePadding="6dp"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/tvVdAgentFilter"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:padding="10dp"
                android:textSize="12.5sp"
                android:textColor="@color/theme_text_primary"
                android:text="All Agents"
                android:gravity="center_vertical" />
        </LinearLayout>

        <!-- Top 4 metric cards, 2x2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <include android:id="@+id/cardVdTotalAssign" layout="@layout/item_vd_metric_card"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginEnd="6dp" />
            <include android:id="@+id/cardVdVerifyRequest" layout="@layout/item_vd_metric_card"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <include android:id="@+id/cardVdHoldReturn" layout="@layout/item_vd_metric_card"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginEnd="6dp" />
            <include android:id="@+id/cardVdDeliveryRequest" layout="@layout/item_vd_metric_card"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Delivery Request Summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ডেলিভারি রিকোয়েস্টের সারাংশ"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="#0099B8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <include android:id="@+id/subVdConfirmed" layout="@layout/item_vd_sub_metric"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                <include android:id="@+id/subVdDelivered" layout="@layout/item_vd_sub_metric"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                <include android:id="@+id/subVdPending" layout="@layout/item_vd_sub_metric"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Funnel: hierarchical card stack (no literal connector lines,
             visual grouping via indentation + a thin left accent bar instead). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp">

            <!-- Level 1: Total Assign -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_rounded"
                android:padding="12dp">
                <View android:layout_width="4dp" android:layout_height="match_parent" android:background="#3B82F6" android:layout_marginEnd="10dp" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/tvVdFunnelTotalLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="মোট অ্যাসাইন" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/theme_text_primary" />
                    <TextView android:id="@+id/tvVdFunnelTotalValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="18sp" android:textStyle="bold" android:textColor="#3B82F6" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="কল সেন্টার এজেন্টদের মোট অ্যাসাইনকৃত পার্সেল" android:textSize="10.5sp" android:textColor="@color/theme_text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="2dp" android:layout_height="14dp" android:layout_marginStart="24dp" android:background="@color/theme_border" />

            <!-- Level 2: Verify Request -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_rounded"
                android:padding="12dp"
                android:layout_marginStart="16dp">
                <View android:layout_width="4dp" android:layout_height="match_parent" android:background="#16A34A" android:layout_marginEnd="10dp" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ভেরিফাই রিকোয়েস্ট" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/theme_text_primary" />
                    <TextView android:id="@+id/tvVdFunnelVerifyValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="18sp" android:textStyle="bold" android:textColor="#16A34A" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="মোট অ্যাসাইন থেকে যে ভেরিফাই রিকোয়েস্ট করা হয়েছে" android:textSize="10.5sp" android:textColor="@color/theme_text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="2dp" android:layout_height="14dp" android:layout_marginStart="32dp" android:background="@color/theme_border" />

            <!-- Level 3: Hold/Return + Delivery Request, side by side -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="16dp">

                <LinearLayout
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp">
                    <View android:layout_width="4dp" android:layout_height="match_parent" android:background="#8B5CF6" android:layout_marginEnd="8dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="ভেরিফাইড (Hold/Return)" android:textSize="10.5sp" android:textStyle="bold" android:textColor="@color/theme_text_primary" />
                        <TextView android:id="@+id/tvVdFunnelHoldReturnValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="16sp" android:textStyle="bold" android:textColor="#8B5CF6" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="যার জন্য পার্সেল ভেরিফাই হয়েছে (এগুলো আর ডেলিভারি হবে না)" android:textSize="9.5sp" android:textColor="@color/theme_text_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="10dp">
                    <View android:layout_width="4dp" android:layout_height="match_parent" android:background="#F97316" android:layout_marginEnd="8dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="ডেলিভারি রিকোয়েস্ট" android:textSize="10.5sp" android:textStyle="bold" android:textColor="@color/theme_text_primary" />
                        <TextView android:id="@+id/tvVdFunnelDeliveryReqValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="16sp" android:textStyle="bold" android:textColor="#F97316" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="যে পার্সেলগুলো ডেলিভারির জন্য পাঠানো হয়েছে" android:textSize="9.5sp" android:textColor="@color/theme_text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="2dp" android:layout_height="14dp" android:layout_marginStart="60dp" android:background="@color/theme_border" />

            <!-- Level 4: Confirmed / Delivered / Pending, under Delivery Request -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="52dp">

                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="8dp" android:layout_marginEnd="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="✅ কনফার্মড" android:textSize="10sp" android:textColor="@color/theme_text_secondary" />
                    <TextView android:id="@+id/tvVdFunnelConfirmedValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#16A34A" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="8dp" android:layout_marginEnd="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🚚 ডেলিভারড" android:textSize="10sp" android:textColor="@color/theme_text_secondary" />
                    <TextView android:id="@+id/tvVdFunnelDeliveredValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#3B82F6" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⏳ পেন্ডিং" android:textSize="10sp" android:textColor="@color/theme_text_secondary" />
                    <TextView android:id="@+id/tvVdFunnelPendingValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#CA8A04" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom quick summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="12dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 এই রিপোর্টের দ্রুত সারাংশ"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="@color/theme_text_primary" />

            <TextView
                android:id="@+id/tvVdQuickSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11.5sp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/theme_text_secondary" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
