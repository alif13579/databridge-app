<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:background="#FFFFFF">

            <ImageButton
                android:id="@+id/btnPcWalletBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Petty Cash Wallet"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbPcWalletLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="60dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutPcWalletError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPcWalletError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B91C1C"
                android:gravity="center" />

            <Button
                android:id="@+id/btnPcWalletRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Retry"
                android:textAllCaps="false" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollPcWallet"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Available Balance hero card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#059669">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Available Balance"
                                android:textSize="12sp"
                                android:textColor="#D1FAE5" />

                            <TextView
                                android:id="@+id/tvPcWalletAvailableBalance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="monospace"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ready to use"
                                android:textSize="11sp"
                                android:textColor="#D1FAE5" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="\uD83D\uDCB3"
                            android:textSize="20sp"
                            android:gravity="center"
                            android:background="#1FFFFFFF" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Wallet stat rows -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <include layout="@layout/item_petty_cash_wallet_row" android:id="@+id/rowWalletApprovedWaiting" />
                    <include layout="@layout/item_petty_cash_wallet_row" android:id="@+id/rowWalletPendingApproval" />
                    <include layout="@layout/item_petty_cash_wallet_row" android:id="@+id/rowWalletSettledMonth" />
                    <include layout="@layout/item_petty_cash_wallet_row" android:id="@+id/rowWalletTotalFund" />
                </LinearLayout>

                <!-- Wallet Utilization -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wallet Utilization (This Month)"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#64748B" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:layout_marginTop="10dp"
                            android:background="#E2E8F0">

                            <View
                                android:id="@+id/viewPcWalletUtilizationBar"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:background="#059669" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvPcWalletUtilizationLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_gravity="end"
                            android:textSize="12sp"
                            android:textColor="#334155" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Auto-refresh -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="\u21BB"
                        android:textSize="13sp"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Auto refresh in 30 sec"
                        android:textSize="12sp"
                        android:textColor="#94A3B8" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
