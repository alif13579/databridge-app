<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:background="#FFFFFF">

            <ImageButton
                android:id="@+id/btnPcMyRequestsBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/tvPcMyRequestsTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="My Petty Cash Requests"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:layout_marginStart="8dp" />

            <!-- Branch switcher chip: hidden by default, shown by
                 PettyCashMyRequestsFragment only when the signed-in user
                 has more than one assigned branch. -->
            <TextView
                android:id="@+id/tvPcMyRequestsBranchName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_branch_switcher_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:maxWidth="140dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbPcMyRequestsLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="60dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutPcMyRequestsError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPcMyRequestsError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B91C1C"
                android:gravity="center" />

            <Button
                android:id="@+id/btnPcMyRequestsRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Retry"
                android:textAllCaps="false" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollPcMyRequests"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- My Petty Cash Summary hero card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#059669">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="My Petty Cash Summary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#D1FAE5" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Total Approved (This Month)"
                            android:textSize="12sp"
                            android:textColor="#D1FAE5" />

                        <TextView
                            android:id="@+id/tvPcMyRequestsApprovedTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 4 mini stat tiles: My Requests / Pending / Approved / Settled -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <include layout="@layout/item_petty_cash_stat_card" android:id="@+id/statPcMyRequestsTotal" />
                    <include layout="@layout/item_petty_cash_stat_card" android:id="@+id/statPcMyRequestsPending" />
                    <include layout="@layout/item_petty_cash_stat_card" android:id="@+id/statPcMyRequestsApproved" />
                    <include layout="@layout/item_petty_cash_stat_card" android:id="@+id/statPcMyRequestsSettled" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="My Requests"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#64748B" />
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:id="@+id/layoutPcMyRequestsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>

        <!-- New Request button — pinned above the bottom nav, matching the
             mockup's sticky bottom action + separate icon row underneath. -->
        <Button
            android:id="@+id/btnPcMyRequestsNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="+ New Petty Cash Request"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#059669"
            android:paddingVertical="14dp" />

        <include layout="@layout/layout_petty_cash_bottom_nav" />
    </LinearLayout>
</FrameLayout>
