<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_parcel_card"
    android:padding="12dp"
    android:layout_marginBottom="6dp">

    <TextView
        android:id="@+id/tvRghName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Dhanmondi"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/theme_text_primary"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tvRghCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="22dp"
        android:gravity="center"
        android:text="3"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/theme_text_inverse"
        android:background="@drawable/bg_filter_chip_active_purple"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_marginStart="8dp" />

    <TextView
        android:id="@+id/tvRghChevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="▶"
        android:textSize="11sp"
        android:textColor="@color/theme_text_secondary"
        android:layout_marginStart="10dp"
        android:padding="4dp" />

</LinearLayout>
