<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:background="#FFFFFF">

            <ImageButton
                android:id="@+id/btnPcRequestCreateBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/tvPcRequestCreateTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="New Petty Cash Request"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Category -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#334155" />

                <LinearLayout
                    android:id="@+id/layoutPcRequestCategory"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_pc_input"
                    android:paddingHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvPcRequestCategorySelected"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Select Category"
                        android:textSize="14sp"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="\u25BC"
                        android:textSize="11sp"
                        android:textColor="#94A3B8" />
                </LinearLayout>

                <!-- Consignment ID — shown only when category == Bulk Delivery -->
                <LinearLayout
                    android:id="@+id/groupPcRequestConsignment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consignment ID"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#334155"
                        android:layout_marginTop="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <EditText
                            android:id="@+id/etPcRequestConsignmentId"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pc_input"
                            android:hint="Type or scan consignment ID"
                            android:textSize="14sp"
                            android:textColor="#0F172A"
                            android:paddingHorizontal="14dp"
                            android:maxLines="1"
                            android:inputType="text" />

                        <TextView
                            android:id="@+id/btnPcRequestScanConsignment"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_pc_input"
                            android:gravity="center"
                            android:text="📷"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <!-- Firebase preview of the entered/scanned id, so the agent can
                         confirm they've got the right parcel before submitting. -->
                    <LinearLayout
                        android:id="@+id/layoutPcRequestConsignmentPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="10dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvPcRequestConsignmentPreview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12.5sp"
                            android:textColor="#0F172A" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Store — shown only when category == Pickup -->
                <LinearLayout
                    android:id="@+id/groupPcRequestStore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Store"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#334155"
                        android:layout_marginTop="16dp" />

                    <LinearLayout
                        android:id="@+id/layoutPcRequestStore"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_pc_input"
                        android:paddingHorizontal="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvPcRequestStoreSelected"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Select Store"
                            android:textSize="14sp"
                            android:textColor="#94A3B8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="\u25BC"
                            android:textSize="11sp"
                            android:textColor="#94A3B8" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Number of Pickups"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#334155"
                        android:layout_marginTop="14dp" />

                    <EditText
                        android:id="@+id/etPcRequestPickupCount"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_pc_input"
                        android:paddingHorizontal="14dp"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textSize="14sp"
                        android:hint="e.g. 3" />
                </LinearLayout>

                <!-- Conveyance fields — shown for both Pickup and Bulk Delivery (per the
                     discussion that decided these apply to both categories, unlike
                     Store/Consignment ID which are category-specific). Vehicle/From/To
                     mirror the remark-picker's same fields and Office-default logic:
                     Pickup defaults To='Office' and prefills From from the selected
                     store's own area; Bulk Delivery defaults From='Office' with To as a
                     plain dropdown (no store to prefill from). See applyConveyanceDefaults()
                     in the Fragment for the actual default-application logic. -->
                <LinearLayout
                    android:id="@+id/groupPcRequestConveyance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vehicle"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#334155"
                        android:layout_marginTop="16dp" />

                    <LinearLayout
                        android:id="@+id/layoutPcRequestVehicle"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_pc_input"
                        android:paddingHorizontal="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvPcRequestVehicleSelected"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Select Vehicle"
                            android:textSize="14sp"
                            android:textColor="#94A3B8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="\u25BC"
                            android:textSize="11sp"
                            android:textColor="#94A3B8" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="From"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#334155"
                        android:layout_marginTop="14dp" />

                    <LinearLayout
                        android:id="@+id/layoutPcRequestFromArea"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_pc_input"
                        android:paddingHorizontal="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvPcRequestFromAreaSelected"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Office"
                            android:textSize="14sp"
                            android:textColor="#0F172A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="\u25BC"
                            android:textSize="11sp"
                            android:textColor="#94A3B8" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="To"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#334155"
                        android:layout_marginTop="14dp" />

                    <LinearLayout
                        android:id="@+id/layoutPcRequestToArea"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_pc_input"
                        android:paddingHorizontal="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvPcRequestToAreaSelected"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Office"
                            android:textSize="14sp"
                            android:textColor="#0F172A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="\u25BC"
                            android:textSize="11sp"
                            android:textColor="#94A3B8" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Attempt Quantity"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#334155"
                        android:layout_marginTop="14dp" />

                    <EditText
                        android:id="@+id/etPcRequestAttemptQuantity"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_pc_input"
                        android:paddingHorizontal="14dp"
                        android:inputType="number"
                        android:maxLength="4"
                        android:textSize="14sp"
                        android:hint="e.g. 5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delivered Quantity"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#334155"
                        android:layout_marginTop="14dp" />

                    <EditText
                        android:id="@+id/etPcRequestDeliveredQuantity"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_pc_input"
                        android:paddingHorizontal="14dp"
                        android:inputType="number"
                        android:maxLength="4"
                        android:textSize="14sp"
                        android:hint="e.g. 4" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CID / Merchant"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#334155"
                        android:layout_marginTop="14dp" />

                    <EditText
                        android:id="@+id/etPcRequestCidOrMerchant"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_pc_input"
                        android:hint="Enter CID or merchant name"
                        android:textSize="14sp"
                        android:textColor="#0F172A"
                        android:paddingHorizontal="14dp"
                        android:maxLines="1"
                        android:inputType="text" />
                </LinearLayout>

                <!-- Amount — hidden for Pickup: the Requester doesn't know the actual
                     cost yet (that comes back from the store), so Staff fills it in
                     after this claim is submitted, not the Requester. -->
                <LinearLayout
                    android:id="@+id/groupPcAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Amount"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#334155"
                        android:layout_marginTop="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_pc_input"
                        android:paddingHorizontal="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="\u09F3"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#64748B" />

                        <EditText
                            android:id="@+id/etPcRequestAmount"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="52dp"
                            android:background="@android:color/transparent"
                            android:inputType="numberDecimal"
                            android:hint="0"
                            android:textSize="16sp"
                            android:textColor="#0F172A"
                            android:paddingStart="8dp"
                            android:maxLines="1" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Purpose -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Purpose"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:layout_marginTop="16dp" />

                <EditText
                    android:id="@+id/etPcRequestPurpose"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_pc_input"
                    android:hint="Describe why this request is needed"
                    android:textSize="14sp"
                    android:textColor="#0F172A"
                    android:padding="14dp"
                    android:gravity="top"
                    android:maxLength="300"
                    android:inputType="textMultiLine" />

                <TextView
                    android:id="@+id/tvPcRequestPurposeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:text="0/300"
                    android:textSize="11sp"
                    android:textColor="#94A3B8" />

                <!-- Attachment (optional, name-only for now — file picker upload TODO) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attachment (Optional)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:layout_marginTop="16dp" />

                <LinearLayout
                    android:id="@+id/layoutPcRequestAttachment"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_pc_input"
                    android:paddingHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvPcRequestAttachmentName"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="No file selected"
                        android:textSize="14sp"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="\uD83D\uDCCE"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Submit -->
                <Button
                    android:id="@+id/btnPcRequestSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Submit Request"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#059669"
                    android:paddingVertical="12dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
