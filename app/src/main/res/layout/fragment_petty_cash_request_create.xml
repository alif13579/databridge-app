<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:background="#FFFFFF">

            <ImageButton
                android:id="@+id/btnPcRequestCreateBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/tvPcRequestCreateTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="New Petty Cash Request"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Category -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#334155" />

                <LinearLayout
                    android:id="@+id/layoutPcRequestCategory"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_pc_input"
                    android:paddingHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvPcRequestCategorySelected"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Select Category"
                        android:textSize="14sp"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="\u25BC"
                        android:textSize="11sp"
                        android:textColor="#94A3B8" />
                </LinearLayout>

                <!-- Consignment ID — shown only when category == Bulk Delivery -->
                <LinearLayout
                    android:id="@+id/groupPcRequestConsignment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consignment ID"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#334155"
                        android:layout_marginTop="16dp" />

                    <EditText
                        android:id="@+id/etPcRequestConsignmentId"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_pc_input"
                        android:hint="Enter consignment ID"
                        android:textSize="14sp"
                        android:textColor="#0F172A"
                        android:paddingHorizontal="14dp"
                        android:maxLines="1"
                        android:inputType="text" />
                </LinearLayout>

                <!-- Store — shown only when category == Pickup -->
                <LinearLayout
                    android:id="@+id/groupPcRequestStore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Store"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#334155"
                        android:layout_marginTop="16dp" />

                    <LinearLayout
                        android:id="@+id/layoutPcRequestStore"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_pc_input"
                        android:paddingHorizontal="14dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvPcRequestStoreSelected"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Select Store"
                            android:textSize="14sp"
                            android:textColor="#94A3B8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="\u25BC"
                            android:textSize="11sp"
                            android:textColor="#94A3B8" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Amount -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amount"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:layout_marginTop="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_pc_input"
                    android:paddingHorizontal="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="\u09F3"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#64748B" />

                    <EditText
                        android:id="@+id/etPcRequestAmount"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="52dp"
                        android:background="@android:color/transparent"
                        android:inputType="numberDecimal"
                        android:hint="0"
                        android:textSize="16sp"
                        android:textColor="#0F172A"
                        android:paddingStart="8dp"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Purpose -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Purpose"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:layout_marginTop="16dp" />

                <EditText
                    android:id="@+id/etPcRequestPurpose"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_pc_input"
                    android:hint="Describe why this request is needed"
                    android:textSize="14sp"
                    android:textColor="#0F172A"
                    android:padding="14dp"
                    android:gravity="top"
                    android:maxLength="300"
                    android:inputType="textMultiLine" />

                <TextView
                    android:id="@+id/tvPcRequestPurposeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:text="0/300"
                    android:textSize="11sp"
                    android:textColor="#94A3B8" />

                <!-- Attachment (optional, name-only for now — file picker upload TODO) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attachment (Optional)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:layout_marginTop="16dp" />

                <LinearLayout
                    android:id="@+id/layoutPcRequestAttachment"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_pc_input"
                    android:paddingHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvPcRequestAttachmentName"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="No file selected"
                        android:textSize="14sp"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="\uD83D\uDCCE"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Requested Date -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Requested Date"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:layout_marginTop="16dp" />

                <LinearLayout
                    android:id="@+id/layoutPcRequestDate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_pc_input"
                    android:paddingHorizontal="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvPcRequestDateSelected"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#0F172A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="\uD83D\uDCC5"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Submit -->
                <Button
                    android:id="@+id/btnPcRequestSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Submit Request"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#059669"
                    android:paddingVertical="12dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
