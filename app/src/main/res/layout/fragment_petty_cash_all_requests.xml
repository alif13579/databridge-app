<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerPcAllReq"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:background="#FFFFFF">

            <ImageButton
                android:id="@+id/btnPcAllReqBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="All Requests"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:layout_marginStart="8dp" />

                <ImageButton
                    android:id="@+id/btnPcAllReqFilter"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_filter_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Filters"
                    android:tint="#0F766E" />
            </LinearLayout>

        <!-- Filter tabs: All / My Requests / Pending / Approved / Settled -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutPcAllReqTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingBottom="10dp" />
        </HorizontalScrollView>

        <!-- Filter + Export + summary (scrollable so Export is never cut off).
             Agent/date picks live only in the right drawer now. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvPcAllReqFilters"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:text="☰ Filters"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:background="@drawable/bg_pc_tab_inactive"
                android:paddingHorizontal="12dp" />

            <TextView
                android:id="@+id/tvPcAllReqExport"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:text="⬇ Export"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0F766E"
                android:background="@drawable/bg_pc_tab_inactive"
                android:paddingHorizontal="12dp"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/tvPcAllReqSelectMode"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:text="☑ Select"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#059669"
                android:paddingHorizontal="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvPcAllReqSelectAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:text="Select all"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#059669"
                android:paddingHorizontal="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvPcAllReqSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minWidth="120dp"
                android:layout_marginStart="12dp"
                android:paddingVertical="8dp"
                android:textSize="12sp"
                android:textColor="#64748B" />
        </LinearLayout>
        </HorizontalScrollView>

        <ProgressBar
            android:id="@+id/pbPcAllReqLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="60dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutPcAllReqError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPcAllReqError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B91C1C"
                android:gravity="center" />

            <Button
                android:id="@+id/btnPcAllReqRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Retry"
                android:textAllCaps="false" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollPcAllReq"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp">

                    <LinearLayout
                        android:id="@+id/layoutPcAllReqList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </androidx.cardview.widget.CardView>

                <!-- Pagination -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:id="@+id/tvPcAllReqPageInfo"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Showing 1 to 5 of 48"
                        android:textSize="12sp"
                        android:textColor="#94A3B8" />

                    <LinearLayout
                        android:id="@+id/layoutPcAllReqPageButtons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Bulk-update bar: visible through all of select mode (Update
             disabled until 1+ picked, so the action can't be missed). -->
        <LinearLayout
            android:id="@+id/layoutPcAllReqBulkBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPcAllReqBulkSummary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/btnPcAllReqBulkCancel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="Cancel"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#374151"
                android:backgroundTint="#F3F4F6"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/btnPcAllReqBulkUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="Update"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_action_button_green"
                    android:paddingHorizontal="18dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right filter drawer (e-commerce style): Date, Status, Category, Agents -->
    <LinearLayout
        android:id="@+id/layoutPcAllReqDrawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Filters"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/tvPcDrawerReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#B91C1C"
                android:padding="8dp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/tvPcDrawerDateState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Any date"
                    android:textSize="13sp"
                    android:textColor="#0F766E"
                    android:paddingBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPcDrawerRange"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Range"
                        android:textAllCaps="false"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPcDrawerBizMonth"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Biz month"
                        android:textAllCaps="false"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPcDrawerMonth"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Month"
                        android:textAllCaps="false"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnPcDrawerClearDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Clear date"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp" />

                <LinearLayout
                    android:id="@+id/layoutPcDrawerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp" />

                <LinearLayout
                    android:id="@+id/layoutPcDrawerCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Agents"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp" />

                <LinearLayout
                    android:id="@+id/layoutPcDrawerAgents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/btnPcDrawerApply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:text="Show results"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnPcDrawerExport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="⬇ Export current filter"
            android:textAllCaps="false"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
