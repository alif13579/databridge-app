<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="560dp"
    android:overScrollMode="never">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_rounded"
    android:padding="16dp"
    android:elevation="12dp">

    <!-- Header: avatar-style initial, name/phone, calling badge, close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvHrInitial"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_overlay_badge_status"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#0099B8" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHrName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvHrPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#64748B" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHrCallingBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calling…"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="#15803D"
            android:background="@drawable/badge_bg_channel"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnHrClose"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_icon_button_chip"
            android:src="@drawable/ic_close_small"
            android:contentDescription="Dismiss"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Parcel info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:paddingTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Consignment" android:textSize="12sp" android:textColor="#64748B" />
            <TextView android:id="@+id/tvHrConsignment" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12.5sp" android:textColor="#0F172A" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Address" android:textSize="12sp" android:textColor="#64748B" />
            <TextView android:id="@+id/tvHrAddress" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1.6" android:gravity="end" android:maxLines="2" android:ellipsize="end"
                android:textSize="12.5sp" android:textColor="#0F172A" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="COD" android:textSize="12sp" android:textColor="#64748B" />
            <TextView android:id="@+id/tvHrCod" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12.5sp" android:textStyle="bold" android:textColor="#0099B8" />
        </LinearLayout>
    </LinearLayout>

    <!-- Call button -->
    <TextView
        android:id="@+id/btnHrCall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_overlay_cta_success"
        android:text="📞 কল করুন"
        android:textColor="#FFFFFF"
        android:textSize="13.5sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingVertical="10dp" />

    <!-- Remarks: collapsed behind a "Set Remarks" button by default (note box was always
         taking up space before), expands to the same chips+note+save shape used when
         tapping remarks directly on a parcel card elsewhere in the app. -->
    <TextView
        android:id="@+id/btnHrSetRemarks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:background="@drawable/bg_overlay_badge_status"
        android:text="📝 রিমার্কস সেট করুন"
        android:textColor="#0F172A"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingVertical="10dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/llHrRemarkSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:text="দ্রুত রিমার্কস"
            android:textSize="11.5sp"
            android:textColor="#64748B" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/llHrRemarkChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <EditText
            android:id="@+id/etHrNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_overlay_badge_status"
            android:hint="নোট লিখুন (ঐচ্ছিক)"
            android:textSize="12.5sp"
            android:minLines="2"
            android:gravity="top|start"
            android:padding="9dp"
            android:inputType="textMultiLine" />

        <!-- Footer actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/btnHrDismiss"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_overlay_badge_status"
                android:text="বন্ধ করুন"
                android:textColor="#0F172A"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingVertical="10dp" />

            <TextView
                android:id="@+id/btnHrSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_overlay_cta"
                android:text="রিমার্কস সেভ করুন"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingVertical="10dp" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tvHrAgentMissing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="⚠ এই পার্সেলের এজেন্ট তথ্য পাওয়া যায়নি — Call Center-এ গিয়ে রিমার্ক দিন"
        android:textSize="11.5sp"
        android:textColor="#B45309"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvHrConfirmation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="✓ রিমার্কস সেভ হয়েছে"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#15803D"
        android:gravity="center"
        android:visibility="gone" />

</LinearLayout>
</ScrollView>
