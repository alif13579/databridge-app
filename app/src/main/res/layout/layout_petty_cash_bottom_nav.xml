<?xml version="1.0" encoding="utf-8"?>
<!--
  Local bottom action bar for Petty Cash screens only, matches the mockup's
  per-screen row (Dashboard / Requests / + / Reports / More). This is
  intentionally separate from activity_main.xml's app-wide BottomNavigationView
  (bottom_nav_menu.xml, Connect/History) rather than added to it, since that
  bar is shared across every feature in the app and Petty Cash's own actions
  don't belong mixed into it.

  Reports and More have no destination screen yet anywhere in the app,
  they're included here for the mockup's visual shape and show a "coming
  soon" toast on tap (wired in code) rather than a fabricated broken screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#FFFFFF"
    android:elevation="8dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:id="@+id/navPcHome"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">

        <TextView
            android:id="@+id/tvNavPcHomeIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\uD83C\uDFE0"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvNavPcHomeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dashboard"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navPcRequests"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\uD83D\uDCCB"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvNavPcRequestsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Requests"
            android:textSize="10sp"
            android:textColor="#64748B"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navPcNew"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="+"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/bg_pc_avatar_circle"
            android:backgroundTint="#059669" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navPcReports"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\uD83D\uDCCA"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reports"
            android:textSize="10sp"
            android:textColor="#64748B"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navPcMore"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u22EF"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="More"
            android:textSize="10sp"
            android:textColor="#64748B"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
