<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:id="@+id/tvEditStatusKeyHint"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="#9CA3AF" android:layout_marginBottom="14dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Bangla" android:textSize="10sp" android:textColor="#9CA3AF"
                    android:textStyle="bold" android:layout_marginBottom="4dp" />
                <EditText android:id="@+id/etEditStatusBn" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="13sp" android:padding="8dp"
                    android:background="@drawable/bg_input_rounded" android:inputType="text" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="4dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="English" android:textSize="10sp" android:textColor="#9CA3AF"
                    android:textStyle="bold" android:layout_marginBottom="4dp" />
                <EditText android:id="@+id/etEditStatusEn" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="13sp" android:padding="8dp"
                    android:background="@drawable/bg_input_rounded" android:inputType="text" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Sort Order (chip / worklist display order)" android:textSize="10sp" android:textColor="#9CA3AF"
            android:textStyle="bold" android:layout_marginBottom="4dp" />
        <EditText android:id="@+id/etEditStatusSortOrder" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp" android:padding="8dp"
            android:background="@drawable/bg_input_rounded"
            android:inputType="number" android:layout_marginBottom="10dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ignored when actual is (this remark hides, actual shows)" android:textSize="10sp" android:textColor="#9CA3AF"
            android:textStyle="bold" android:layout_marginBottom="4dp" />
        <TextView android:id="@+id/tvIgnoreHint"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="#9CA3AF" android:layout_marginBottom="4dp" />
        <LinearLayout android:id="@+id/ignoreChipContainer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginBottom="4dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="6dp">
            <Spinner android:id="@+id/spinnerIgnoreActual"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="6dp" />
            <Button android:id="@+id/btnAddIgnore"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="＋ Add" android:textSize="12sp" android:minHeight="0dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="10dp">
            <EditText android:id="@+id/etCustomIgnore"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="6dp"
                android:hint="Custom actual status (e.g. Cancelled)" android:textSize="13sp" android:padding="8dp"
                android:background="@drawable/bg_input_rounded" android:inputType="text" android:singleLine="true" />
            <Button android:id="@+id/btnAddCustomIgnore"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="＋ Custom" android:textSize="12sp" android:minHeight="0dp" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Color" android:textSize="10sp" android:textColor="#9CA3AF"
            android:textStyle="bold" android:layout_marginBottom="6dp" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none" android:layout_marginBottom="8dp">
            <LinearLayout android:id="@+id/colorPickerEdit"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
        <TextView android:id="@+id/tvEditColorPreview"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="3dp" android:paddingBottom="3dp" />
    </LinearLayout>
</ScrollView>
