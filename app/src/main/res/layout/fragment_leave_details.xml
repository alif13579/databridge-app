<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:background="#FFFFFF">

            <ImageButton
                android:id="@+id/btnLmDetailBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/tvLmDetailTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Leave Request"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/tvLmDetailStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#B45309"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Summary card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_pc_input"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvLmDetailRequestCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <TextView
                        android:id="@+id/tvLmDetailWorker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        android:textColor="#334155" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E2E8F0"
                        android:layout_marginVertical="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Leave Type"
                        android:textSize="11sp"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:id="@+id/tvLmDetailLeaveType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvLmDetailLeaveDateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Leave Date"
                        android:textSize="11sp"
                        android:textColor="#94A3B8"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/tvLmDetailLeaveDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#0F172A"
                        android:layout_marginTop="2dp" />

                    <LinearLayout
                        android:id="@+id/groupLmDetailDutyDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Duty Date"
                            android:textSize="11sp"
                            android:textColor="#94A3B8"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:id="@+id/tvLmDetailDutyDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="#0F172A"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Leave Reliever"
                        android:textSize="11sp"
                        android:textColor="#94A3B8"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/tvLmDetailReliever"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#0F172A"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reason / Remarks"
                        android:textSize="11sp"
                        android:textColor="#94A3B8"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/tvLmDetailReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#0F172A"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Timeline -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Approval Timeline"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#334155"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/layoutLmDetailTimeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Actions -->
                <Button
                    android:id="@+id/btnLmDetailPrimaryAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#059669"
                    android:paddingVertical="12dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnLmDetailReject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Reject"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#DC2626"
                    android:backgroundTint="#FEE2E2"
                    android:paddingVertical="12dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutLmDetailOwnerActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btnLmDetailEdit"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Edit"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:backgroundTint="#E2E8F0"
                        android:paddingVertical="12dp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnLmDetailDelete"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Delete"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textColor="#DC2626"
                        android:backgroundTint="#FEE2E2"
                        android:paddingVertical="12dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
