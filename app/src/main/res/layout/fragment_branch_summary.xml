<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipeBsRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_bg_dashboard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Branch Summary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/theme_text_primary" />

        <TextView
            android:id="@+id/tvBsScope"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/theme_text_primary"
            android:layout_marginTop="2dp" />

        <ProgressBar
            android:id="@+id/pbBsLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvBsError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#DC2626"
            android:textSize="12.5sp"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <!-- Filters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvBsDateRange"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_rounded"
                android:padding="10dp"
                android:textSize="12.5sp"
                android:textColor="@color/theme_text_primary"
                android:drawablePadding="6dp"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/tvBsBranch"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:padding="10dp"
                android:textSize="12.5sp"
                android:textColor="@color/theme_text_primary"
                android:gravity="center_vertical" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Summary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/theme_text_primary"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/layoutBsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="10dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvBsRunsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Runs"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/theme_text_primary"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/layoutBsRuns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
