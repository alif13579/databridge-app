<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F1F5F9">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="90dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Cash Management"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <!-- Branch switcher chip: hidden by default, shown by
                         CashManagementHomeFragment only when the signed-in
                         user has more than one assigned branch. -->
                    <TextView
                        android:id="@+id/tvHomeBranchName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_branch_switcher_chip"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:maxWidth="140dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/btnHomeExportCsv"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/stat_sys_download"
                        android:contentDescription="Export CSV" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbHomeLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="60dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutHomeError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvHomeError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#B91C1C"
                        android:gravity="center" />

                    <Button
                        android:id="@+id/btnHomeRetry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Retry"
                        android:textAllCaps="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutHomeContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Need to pay to hub"
                                    android:textSize="12sp"
                                    android:textColor="#64748B" />

                                <TextView
                                    android:id="@+id/tvHomeNeedToPay"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="monospace"
                                    android:textSize="26sp"
                                    android:textStyle="bold"
                                    android:textColor="#0F172A" />

                                <TextView
                                    android:id="@+id/tvHomeAgainstCollection"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="11sp"
                                    android:textColor="#94A3B8" />

                                <TextView
                                    android:id="@+id/tvHomeDateRange"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="All time"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="#334155"
                                    android:background="#F1F5F9"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <include layout="@layout/item_home_stat_row" android:id="@+id/statCollected" />
                                <include layout="@layout/item_home_stat_row" android:id="@+id/statCashInHand" />
                                <include layout="@layout/item_home_stat_row" android:id="@+id/statMfsBalance" />
                                <include layout="@layout/item_home_stat_row" android:id="@+id/statPaidToHub" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Step flow -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="10dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp">

                        <LinearLayout
                            android:id="@+id/layoutStepFlow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp" />
                    </androidx.cardview.widget.CardView>

                    <!-- Wallets -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="18dp"
                        android:layout_marginHorizontal="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="WALLETS (MFS BALANCE)"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/tvManageWallets"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Manage \u203A"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#6D28D9"
                            android:padding="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutWalletCards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp"
                        android:layout_marginHorizontal="12dp" />

                    <!-- Recent Activity -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="18dp"
                        android:layout_marginHorizontal="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="RECENT ACTIVITY"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#64748B"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/tvViewAllActivity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View all \u203A"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#6D28D9"
                            android:padding="4dp" />
                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp">

                        <LinearLayout
                            android:id="@+id/layoutRecentActivity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- FAB -->
        <Button
            android:id="@+id/btnHomeFab"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="28dp"
            android:elevation="10dp"
            android:text="+"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="30dp"
            android:backgroundTint="#059669" />

        <!-- Speed dial overlay -->
        <LinearLayout
            android:id="@+id/layoutSpeedDial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="bottom|end"
            android:background="#66020617"
            android:paddingEnd="16dp"
            android:paddingBottom="100dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/layoutSpeedDialItems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </FrameLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
