<?xml version="1.0" encoding="utf-8"?>
<!-- No pull-to-refresh here by request: the swipe gesture kept stealing
     upward scrolls, making the list impossible to scroll up. The list reloads
     on resume, tab/filter changes, and after every action instead. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F1F5F9">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Toolbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:background="#FFFFFF">

                <ImageButton
                    android:id="@+id/btnPcPendingBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_revert"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back" />

                <TextView
                    android:id="@+id/tvPcPendingTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Requests"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/tvPcPendingRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All Time"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#0F766E"
                    android:paddingHorizontal="6dp" />

                <TextView
                    android:id="@+id/tvPcPendingRangeClear"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#B91C1C"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnPcPendingCalendar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_calendar"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Filter by date" />
            </LinearLayout>

            <!-- Filter tabs: All + one per status actually present (up to 7
                 total) — can overflow a single screen width, so scrollable
                 left-to-right rather than clipped/squeezed. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:scrollbars="none"
                android:overScrollMode="ifContentScrolls">

                <LinearLayout
                    android:id="@+id/layoutPcPendingTabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingBottom="10dp" />
            </HorizontalScrollView>

            <!-- Agent/category filter + filtered total. The chips scroll
                 horizontally (like the tabs above) so long picks like
                 "3 agents (15)" never squeeze the row or grow the page. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:paddingHorizontal="16dp"
                android:paddingBottom="8dp">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:overScrollMode="ifContentScrolls">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvPcPendingAgent"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:gravity="center_vertical"
                            android:text="👥 All Agents"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#6D28D9"
                            android:background="@drawable/bg_pc_tab_inactive"
                            android:paddingHorizontal="12dp"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/tvPcPendingCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:gravity="center_vertical"
                            android:text="🏷 Category"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#0F766E"
                            android:background="@drawable/bg_pc_tab_inactive"
                            android:paddingHorizontal="12dp"
                            android:layout_marginStart="8dp"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/tvPcPendingSelectMode"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:gravity="center_vertical"
                            android:text="☑ Select"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#059669"
                            android:paddingHorizontal="10dp"
                            android:visibility="gone"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/tvPcPendingSelectAll"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:gravity="center_vertical"
                            android:text="Select all"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#059669"
                            android:paddingHorizontal="10dp"
                            android:visibility="gone"
                            android:singleLine="true" />
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/tvPcPendingSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:paddingStart="8dp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbPcPendingLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="60dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutPcPendingError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvPcPendingError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B91C1C"
                    android:gravity="center" />

                <Button
                    android:id="@+id/btnPcPendingRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Retry"
                    android:textAllCaps="false" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/scrollPcPendingList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:clipToPadding="false"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/layoutPcPendingList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp" />
            </ScrollView>

            <!-- Bulk-update bar: visible through all of select mode (Update
                   disabled until 1+ picked, so the action can't be missed).
                   One next-status for every picked claim (Settle keeps one
                   payment method + one transaction id, e.g. a single bkash
                   transfer covering one agent's total). -->
            <LinearLayout
                android:id="@+id/layoutPcBulkBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:elevation="8dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvPcBulkSummary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/btnPcBulkCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="Cancel"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#374151"
                    android:backgroundTint="#F3F4F6"
                    android:paddingHorizontal="14dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/btnPcBulkUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="Update"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_action_button_green"
                    android:paddingHorizontal="18dp" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</FrameLayout>
