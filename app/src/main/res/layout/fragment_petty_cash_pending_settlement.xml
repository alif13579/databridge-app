<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshPcPending"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F1F5F9">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Toolbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:background="#FFFFFF">

                <ImageButton
                    android:id="@+id/btnPcPendingBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_revert"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back" />

                <TextView
                    android:id="@+id/tvPcPendingTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Requests"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:layout_marginStart="8dp" />

                <ImageButton
                    android:id="@+id/btnPcPendingHistory"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Settlement History" />

                <TextView
                    android:id="@+id/btnPcPendingSelect"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="Select"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#059669"
                    android:paddingHorizontal="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Bulk select"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnPcPendingFilter"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Filter" />
            </LinearLayout>

            <!-- Filter tabs: All + one per status actually present (up to 7
                 total) — can overflow a single screen width, so scrollable
                 left-to-right rather than clipped/squeezed. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:scrollbars="none"
                android:overScrollMode="ifContentScrolls">

                <LinearLayout
                    android:id="@+id/layoutPcPendingTabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingBottom="10dp" />
            </HorizontalScrollView>

            <ProgressBar
                android:id="@+id/pbPcPendingLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="60dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutPcPendingError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvPcPendingError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B91C1C"
                    android:gravity="center" />

                <Button
                    android:id="@+id/btnPcPendingRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Retry"
                    android:textAllCaps="false" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/scrollPcPendingList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:clipToPadding="false"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/layoutPcPendingList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp" />
            </ScrollView>

            <!-- Bulk-settle bar: visible only in select mode with 1+ picked.
                 One payment method + one transaction id settles every picked
                 claim (same bkash transfer covering one agent's total). -->
            <LinearLayout
                android:id="@+id/layoutPcBulkBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#FFFFFF"
                android:elevation="8dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvPcBulkSummary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A" />

                <TextView
                    android:id="@+id/btnPcBulkCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="Cancel"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#374151"
                    android:backgroundTint="#F3F4F6"
                    android:paddingHorizontal="14dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/btnPcBulkSettle"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="Settle"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#059669"
                    android:paddingHorizontal="18dp" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
