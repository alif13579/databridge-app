<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F1F5F9">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:padding="14dp">

        <ImageButton
            android:id="@+id/btnListBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/tvListTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <ImageButton
            android:id="@+id/btnExportCsv"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:background="@drawable/bg_icon_button_chip"
            android:src="@drawable/ic_download"
            android:contentDescription="Export CSV" />
    </LinearLayout>

    <!-- Mode tabs: Collections / Deposits / Payments -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutCashModeTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingBottom="10dp" />
    </HorizontalScrollView>

    <!-- Search -->
    <EditText
        android:id="@+id/etListSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="#FFFFFF"
        android:hint="Search..."
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textSize="13sp"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp" />

    <!-- Filters -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvFilterDate"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="Date: All"
            android:textSize="12sp"
            android:textColor="#334155"
            android:background="#FFFFFF"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvFilterChannel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="Channel: All"
            android:textSize="12sp"
            android:textColor="#334155"
            android:background="#FFFFFF"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvFilterStatus"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Status: All"
            android:textSize="12sp"
            android:textColor="#334155"
            android:background="#FFFFFF"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp"
            android:gravity="center" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbListLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="40dp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/layoutListItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="12dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Pagination -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvPaginationInfo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#64748B" />

        <ImageButton
            android:id="@+id/btnPagePrev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="Previous page" />

        <ImageButton
            android:id="@+id/btnPageNext"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="Next page" />
    </LinearLayout>
</LinearLayout>
