<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_parcel_card"
    android:padding="10dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCleanupRowParcel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DB-2202"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/theme_text_primary"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tvCleanupRowMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="12-09-26 · 1:23 · agent"
            android:textSize="11sp"
            android:textColor="@color/theme_text_secondary"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/tvCleanupRowSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1.2 MB"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/theme_text_primary"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnCleanupRowDelete"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="✕"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#EF4444"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/bg_close_button_red"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginStart="8dp"
        android:includeFontPadding="false" />

</LinearLayout>
