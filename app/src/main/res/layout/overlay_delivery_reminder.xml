<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="620dp"
    android:overScrollMode="never">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_rounded"
    android:padding="16dp"
    android:elevation="12dp">

    <!-- Header: consignment id + close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDrConsignment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15.5sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:id="@+id/btnDrClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="15sp"
            android:textColor="#64748B" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDrMoreCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:textColor="#EA580C"
        android:visibility="gone" />

    <!-- Customer / address / status / COD -->
    <TextView
        android:id="@+id/tvDrCustomer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="14sp"
        android:textColor="#0F172A" />

    <TextView
        android:id="@+id/tvDrAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12.5sp"
        android:textColor="#64748B" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDrStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12.5sp"
            android:textColor="#334155" />

        <TextView
            android:id="@+id/tvDrCod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />
    </LinearLayout>

    <!-- CC's last remark -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="#E2E8F0" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗣 CC-র শেষ Remark"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:textColor="#0099B8" />

    <TextView
        android:id="@+id/tvDrCcRemark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="13.5sp"
        android:textColor="#0F172A" />

    <TextView
        android:id="@+id/tvDrCcMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11.5sp"
        android:textColor="#94A3B8" />

    <!-- 3 quick options -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="#E2E8F0" />

    <TextView
        android:id="@+id/optDrWillDeliver"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_pc_input"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="পার্সেলটি ডেলিভারি করা হবে"
        android:textSize="13.5sp"
        android:textColor="#0F172A" />

    <TextView
        android:id="@+id/optDrDelivered"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pc_input"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="পার্সেলটি ডেলিভারি হয়ে গেছে"
        android:textSize="13.5sp"
        android:textColor="#0F172A" />

    <TextView
        android:id="@+id/optDrOthers"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pc_input"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:text="Others…"
        android:textSize="13.5sp"
        android:textColor="#0F172A" />

    <!-- Call button -->
    <TextView
        android:id="@+id/btnDrCall"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_overlay_badge_status"
        android:gravity="center"
        android:text="📞 Call"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#0099B8" />

</LinearLayout>
</ScrollView>
