<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvLmQueueRowAvatar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@drawable/bg_pc_avatar_circle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/tvLmQueueRowCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/theme_text_primary" />

            <TextView
                android:id="@+id/tvLmQueueRowSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/theme_text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLmQueueRowLeaveType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/theme_text_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLmQueueRowDates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:textColor="@color/theme_text_secondary" />

    <TextView
        android:id="@+id/tvLmQueueRowReliever"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:textColor="@color/theme_text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tvLmQueueRowStatus"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#B45309" />

        <TextView
            android:id="@+id/btnLmQueueRowReject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="Reject"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#DC2626"
            android:background="@drawable/bg_pc_input"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnLmQueueRowAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="Acknowledge"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/theme_text_inverse"
            android:background="@color/theme_green"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/theme_bg_app" />
</LinearLayout>
