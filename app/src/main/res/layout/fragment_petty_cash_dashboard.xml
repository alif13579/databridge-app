<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshPcDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F1F5F9">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Toolbar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <ImageButton
                        android:id="@+id/btnPcDashboardBack"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_revert"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Back" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:id="@+id/tvPcDashboardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Accounts"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />

                        <TextView
                            android:id="@+id/tvPcDashboardSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Petty Cash Management"
                            android:textSize="11sp"
                            android:textColor="#64748B" />
                    </LinearLayout>

                    <!-- Branch switcher chip: hidden by default, shown by
                         PettyCashDashboardFragment only when the signed-in
                         user has more than one assigned branch. -->
                    <TextView
                        android:id="@+id/tvPcDashboardBranchName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_branch_switcher_chip"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:maxWidth="140dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:layout_marginEnd="6dp"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/btnPcDashboardNewRequest"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_input_add"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="New Request" />

                    <ImageButton
                        android:id="@+id/btnPcDashboardReports"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_recent_history"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Reports" />

                    <ImageButton
                        android:id="@+id/btnPcDashboardNotif"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_popup_reminder"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Notifications" />
                </LinearLayout>

                <!-- Role switcher — only shown when the signed-in user holds more
                     than one petty-cash role (e.g. both Cash POC and Accounts),
                     letting them toggle which role's dashboard they're viewing. -->
                <LinearLayout
                    android:id="@+id/layoutPcRoleToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/pbPcDashboardLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="60dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutPcDashboardError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvPcDashboardError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#B91C1C"
                        android:gravity="center" />

                    <Button
                        android:id="@+id/btnPcDashboardRetry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Retry"
                        android:textAllCaps="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutPcNoRoleState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You don't have a petty cash role assigned for this branch."
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:gravity="center" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutPcDashboardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Available Balance hero card (Accounts view only) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardPcAvailableBalanceHero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#059669">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="18dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Available Balance"
                                    android:textSize="12sp"
                                    android:textColor="#D1FAE5" />

                                <TextView
                                    android:id="@+id/tvPcAvailableBalance"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="monospace"
                                    android:textSize="26sp"
                                    android:textStyle="bold"
                                    android:textColor="#FFFFFF" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ready to use"
                                    android:textSize="11sp"
                                    android:textColor="#D1FAE5" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:text="\uD83D\uDCB3"
                                android:textSize="20sp"
                                android:gravity="center"
                                android:background="#1FFFFFFF" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Summary hero card (Team Aligned / Cash POC view) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardPcSummaryHero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#EA580C"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:id="@+id/tvPcSummaryRoleLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Team Summary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="#FFEDD5" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="This Month"
                                android:textSize="11sp"
                                android:textColor="#FFEDD5" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Total Requests"
                                android:textSize="12sp"
                                android:textColor="#FFEDD5" />

                            <TextView
                                android:id="@+id/tvPcSummaryTotalRequests"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- 3 stat cards row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp"
                        android:layout_marginHorizontal="12dp"
                        android:weightSum="3">

                        <include layout="@layout/item_petty_cash_stat_card" android:id="@+id/statPcPendingApproval" />
                        <include layout="@layout/item_petty_cash_stat_card" android:id="@+id/statPcApprovedSettlement" />
                        <include layout="@layout/item_petty_cash_stat_card" android:id="@+id/statPcSettledMonth" />
                    </LinearLayout>

                    <!-- Total Fund card -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardPcTotalFund"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginHorizontal="16dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:text="\uD83D\uDCE6"
                                android:textSize="15sp"
                                android:gravity="center"
                                android:background="#EDE9FE" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="Total Fund"
                                android:textSize="13sp"
                                android:textColor="#334155" />

                            <TextView
                                android:id="@+id/tvPcTotalFund"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="#0F172A" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Claims Summary: Requested / Approved / Settled totals for a date range,
                         default "This Month". Approved is the visual anchor (large/bold) since
                         it's the pending-settlement balance — money already committed but not
                         yet paid out. -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginHorizontal="16dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="CLAIMS SUMMARY"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="#64748B"
                                    android:letterSpacing="0.05" />

                                <TextView
                                    android:id="@+id/tvPcClaimsDateRange"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="This Month"
                                    android:textSize="11.5sp"
                                    android:textStyle="bold"
                                    android:textColor="#0099B8"
                                    android:padding="4dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:foreground="?attr/selectableItemBackground" />
                            </LinearLayout>

                            <!-- Approved: the visual anchor -->
                            <TextView
                                android:id="@+id/tvPcClaimsApproved"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="monospace"
                                android:textStyle="bold"
                                android:textSize="26sp"
                                android:textColor="#0F172A" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Approved (Unsettled)"
                                android:textSize="11sp"
                                android:textColor="#94A3B8" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="10dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/tvPcClaimsRequested"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="monospace"
                                        android:textStyle="bold"
                                        android:textSize="14sp"
                                        android:textColor="#CA8A04" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Requested"
                                        android:textSize="10.5sp"
                                        android:textColor="#94A3B8" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/tvPcClaimsSettled"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="monospace"
                                        android:textStyle="bold"
                                        android:textSize="14sp"
                                        android:textColor="#16A34A" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Settled"
                                        android:textSize="10.5sp"
                                        android:textColor="#94A3B8" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QUICK ACTIONS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:letterSpacing="0.05"
                        android:layout_marginTop="18dp"
                        android:layout_marginStart="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:layout_marginHorizontal="12dp"
                        android:weightSum="4">

                        <include layout="@layout/item_petty_cash_quick_action" android:id="@+id/actionPcDepositFund" />
                        <include layout="@layout/item_petty_cash_quick_action" android:id="@+id/actionPcPendingSettlement" />
                        <include layout="@layout/item_petty_cash_quick_action" android:id="@+id/actionPcAllRequests" />
                        <include layout="@layout/item_petty_cash_quick_action" android:id="@+id/actionPcReports" />
                    </LinearLayout>

                    <!-- Settlement Queue -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="20dp"
                        android:layout_marginHorizontal="16dp">

                        <TextView
                            android:id="@+id/tvPcQueueTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Settlement Queue (10)"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />

                        <TextView
                            android:id="@+id/tvPcViewAllQueue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View all"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#059669"
                            android:padding="4dp" />
                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="1dp">

                        <LinearLayout
                            android:id="@+id/layoutPcQueueList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </FrameLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
