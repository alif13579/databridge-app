<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/connect_bg"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- 1️⃣ Disconnected Screen -->
    <LinearLayout
        android:id="@+id/layoutDisconnected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disconnected"
            android:textColor="@color/connect_error"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp" />

        <!-- Google Sign-In Section (only way to connect) -->
        <LinearLayout
            android:id="@+id/layoutGoogleSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in with Google to connect the app and extension"
                android:textColor="@color/connect_text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnGoogleSignIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sign in with Google"
                android:backgroundTint="@color/connect_accent"
                android:textColor="@color/connect_on_accent"
                android:textSize="18sp"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2️⃣ Connected Screen -->
    <LinearLayout
        android:id="@+id/layoutConnected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✅ Connected"
            android:textColor="@color/connect_success"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvConnectedName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="---"
            android:textColor="@color/connect_accent"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvConnectedUid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UID: ---"
            android:textColor="@color/connect_text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="40dp" />

        <Button
            android:id="@+id/btnDisconnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔌 Disconnect"
            android:backgroundTint="@color/connect_error"
            android:textColor="@color/connect_on_error"
            android:textSize="18sp"
            android:padding="12dp" />
    </LinearLayout>
</LinearLayout>