<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="DashboardSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">#64748b</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <!-- Bulk update popup: slides in from the left, out to the right. -->
    <style name="PcBulkDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/pc_slide_in_left</item>
        <item name="android:windowExitAnimation">@anim/pc_slide_out_right</item>
    </style>

</resources>
